{
  "name": "stockflow-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "StockFlow - SaaS Multi-tenant Inventory Management System MVP",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "db:studio": "npm --prefix backend run prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
